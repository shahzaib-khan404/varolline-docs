# ============================================================
# uLovepdf — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="uLovepdf"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=ulovepdf
POSTGRES_PASSWORD=ulovepdf_secret
POSTGRES_DB=ulovepdf_docs
DATABASE_URL=postgresql+asyncpg://ulovepdf:ulovepdf_secret@localhost:5432/ulovepdf_docs
DATABASE_URL_SYNC=postgresql://ulovepdf:ulovepdf_secret@localhost:5432/ulovepdf_docs

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379/0

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="uLovepdf"

NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production

# ── Storage ──────────────────────────────────────────────────
STORAGE_BACKEND=local           # local | s3 | r2
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Cloudflare R2 (optional)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# ── File Limits ───────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
TEMP_FILE_TTL_HOURS=24

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ── Email ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ulovepdf.com

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secret@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secret@localhost:6379/1
